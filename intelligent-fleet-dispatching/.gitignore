# Generated artefacts: never commit checkpoints, datasets, logs, or results
checkpoints/*
!checkpoints/.gitkeep
results/*
!results/.gitkeep
data/*
!data/.gitkeep
*.pt
*.pth
*.tmp
*.npz
*.npy
tensorboard/
events.out.tfevents.*

